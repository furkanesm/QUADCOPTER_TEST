# Reproducible Dockerfile for S500 Quadcopter SITL pinned to official ArduCopter V4.7.1
FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 1. Official ROS 2 pinned snapshot repository (ensures reproducible mavros packages)
RUN echo "deb [trusted=yes] http://snapshots.ros.org/humble/2026-07-02/ubuntu jammy main" > /etc/apt/sources.list.d/ros2.list && \
    rm -f /etc/apt/sources.list.d/ros2.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    ca-certificates \
    build-essential \
    ccache \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    libxml2-dev \
    libxslt1-dev \
    procps \
    ros-humble-mavros \
    ros-humble-mavros-msgs \
    ros-humble-mavros-extras \
    && rm -rf /var/lib/apt/lists/*

# 2. GeographicLib datasets for MAVROS
RUN /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh || true

# 3. Python packages required by ArduPilot SITL and MAVProxy
# Note: empy must be 3.3.4 (empy 4.x is incompatible with ArduPilot waf generator)
RUN pip3 install --no-cache-dir \
    "empy==3.3.4" \
    "future>=0.18.2" \
    "pexpect>=4.8.0" \
    "pyserial>=3.5" \
    "pymavlink>=2.4.35" \
    "MAVProxy>=1.8.60"

# 4. Clone ArduPilot official release tag Copter-4.7.1 and full recursive submodules
WORKDIR /opt
RUN git clone --depth 1 --branch Copter-4.7.1 https://github.com/ArduPilot/ardupilot.git /opt/ardupilot && \
    cd /opt/ardupilot && \
    git submodule update --init --recursive

# 5. Configure and build ArduCopter SITL binary with standard -Werror (clean, zero warnings)
WORKDIR /opt/ardupilot
ENV PATH="/opt/ardupilot/Tools/autotest:/usr/lib/ccache:${PATH}"
RUN ./waf configure --board sitl && ./waf copter

WORKDIR /workspace
ENV SHELL=/bin/bash
CMD ["/bin/bash"]
