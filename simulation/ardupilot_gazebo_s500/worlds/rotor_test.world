<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- 
    TEST KAPSAMI: Kararlı devirde rotor itki kontrolü. 
    Motor geçici (transient) tepkisi doğrulanmıyor. 
    Mevcut S500 custom modelindeki rotor kütlesi, ataleti, geometrisi ve LiftDrag katsayıları birebir kullanılmıştır.
  -->
  <world name="rotor_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="libignition-gazebo-forcetorque-system.so" name="ignition::gazebo::systems::ForceTorque"></plugin>

    <model name="rotor_stand">
      <pose>0 0 1 0 0 0</pose>
      
      <!-- Base that is fixed to the world -->
      <link name="dummy_link">
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>
      <joint name="world_to_dummy" type="fixed">
        <parent>world</parent>
        <child>dummy_link</child>
      </joint>

      <!-- The load cell (force torque sensor) is placed here -->
      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="ft_joint" type="fixed">
        <parent>dummy_link</parent>
        <child>base_link</child>
        <sensor name="ft_sensor" type="force_torque">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <force_torque>
            <frame>child</frame>
            <measure_direction>child_to_parent</measure_direction>
          </force_torque>
        </sensor>
      </joint>

      <!-- Rotor exact geometry and plugins from s500_custom_with_ardupilot -->
      <link name="rotor_0">
        <pose>0 0 0.2 0 0 0</pose>
        <inertial>
          <mass>0.010625</mass>
          <inertia>
            <ixx>4.14375e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.08492e-05</iyy><iyz>0</iyz><izz>7.12317e-05</izz>
          </inertia>
        </inertial>
        <collision name="rotor_0_collision">
          <geometry><cylinder><length>0.005</length><radius>0.1397</radius></cylinder></geometry>
        </collision>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <child>rotor_0</child>
        <parent>base_link</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
          <dynamics><damping>0.004</damping></dynamics>
        </axis>
      </joint>

      <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
        <joint_name>rotor_0_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>5.0</p_gain>
        <i_gain>1.0</i_gain>
      </plugin>
      
      <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
        <joint_name>rotor_0_joint</joint_name>
        <update_rate>50</update_rate>
      </plugin>

      <!-- Exact LiftDrag plugins for rotor 0 -->
      <plugin filename="libignition-gazebo-lift-drag-system.so" name="ignition::gazebo::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>5.153257</cla><cda>0.10</cda><cma>0.00</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>0.084 0 0</cp>
        <forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name>
      </plugin>
      <plugin filename="libignition-gazebo-lift-drag-system.so" name="ignition::gazebo::systems::LiftDrag">
        <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>5.153257</cla><cda>0.10</cda><cma>0.00</cma>
        <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
        <area>0.002</area><air_density>1.2041</air_density><cp>-0.084 0 0</cp>
        <forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name>
      </plugin>
    </model>
  </world>
</sdf>
