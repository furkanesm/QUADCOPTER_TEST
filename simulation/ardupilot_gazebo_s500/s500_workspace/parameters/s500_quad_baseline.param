MAV2_EXT_STAT,1
MAV2_RC_CHAN,1
MAV2_RAW_CTRL,1
MAV2_POSITION,2
MAV2_EXTRA1,2
MAV2_EXTRA2,2
MAV2_EXTRA3,1
MAV2_PARAMS,3

