MAV3_EXT_STAT,2
MAV3_RC_CHAN,2
MAV3_RAW_CTRL,1
MAV3_POSITION,10
MAV3_EXTRA1,10
MAV3_EXTRA2,10
MAV3_EXTRA3,2
