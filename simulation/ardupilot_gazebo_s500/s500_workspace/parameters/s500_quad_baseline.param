RTL_ALT_FINAL_M,0
RTL_SPEED_MS,0
RTL_CONE_SLOPE,3
RTL_LOIT_TIME,5000
RTL_CLIMB_MIN_M,0

# ---- Log ----
LOG_BACKEND_TYPE,1
LOG_BITMASK,176126
LOG_DISARMED,0
LOG_FILE_DSRMROT,1
LOG_FILE_BUFSIZE,200
LOG_FILE_TIMEOUT,5
LOG_REPLAY,0

# ---- Arming ----
# NOT: V4.7'de ARMING_CHECK -> ARMING_SKIPCHK oldu VE MANTIK TERS DONDU.
# Eskiden ARMING_CHECK=1 "tum kontrolleri calistir" demekti.
# Simdi ARMING_SKIPCHK bir "atlama" maskesi; 0 = hicbir kontrolu atlama = tumunu calistir (istedigimiz budur)
ARMING_SKIPCHK,0
BRD_SAFETY_DEFLT,1
BRD_SAFETYENABLE,1
